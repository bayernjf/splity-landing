---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import { SITE } from "../consts.ts";
import {
  useTranslations,
  getLocalizedPath,
  getAltLang,
  getAltLangPath,
  languages,
  type Lang,
} from "../i18n/utils.ts";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);

// 本地化导航链接：en -> /#features，zh -> /zh/#features
const navItems = [
  { label: t.navFeatures, href: getLocalizedPath("/#features", lang) },
  { label: t.navDemo, href: getLocalizedPath("/#demo", lang) },
  { label: t.navFaq, href: getLocalizedPath("/#faq", lang) },
  { label: t.navBlog, href: getLocalizedPath("/blog", lang) },
  { label: t.navAbout, href: getLocalizedPath("/about", lang) },
];
const homeHref = getLocalizedPath("/", lang);

const altLang = getAltLang(lang);
const altLangHref = getAltLangPath(Astro.url.pathname, altLang);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={homeHref} class="brand" aria-label={t.headerBrandAria}>
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span class="brand-name">Splity</span>
    </a>

    <nav class="nav" aria-label={t.headerNavAria}>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <BayjfLink size={18} />
    </nav>

    <div class="header-actions">
      <a
        class="lang-switch"
        href={altLangHref}
        hreflang={altLang === "zh" ? "zh-CN" : "en"}
        aria-label={t.headerLangSwitchAria}
      >
        {languages[altLang]}
      </a>
      <a href={SITE.appUrl} class="btn btn-primary btn-sm header-cta">{t.navCta}</a>
      <button
        id="menu-toggle"
        class="menu-toggle"
        type="button"
        aria-label={t.headerMenuToggleAria}
        aria-controls="mobile-nav"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="icon-open" d="M4 7h16M4 12h16M4 17h16" />
          <path class="icon-close" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label={t.headerMobileNavAria}>
    <div class="container mobile-nav-inner">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <BayjfLink size={18} />
      <a href={SITE.appUrl} class="btn btn-primary">{t.navCta}</a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--text);
  }

  .nav {
    display: flex;
    gap: 32px;
    font-size: 0.95rem;
  }

  .nav a {
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .nav a:hover {
    color: var(--primary);
  }

  .btn-sm {
    padding: 8px 20px;
    font-size: 0.9rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .lang-switch {
    color: var(--text-secondary);
    font-size: 0.9rem;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .lang-switch:hover {
    color: var(--primary);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }

  .menu-toggle:hover {
    color: var(--primary);
  }

  .menu-toggle .icon-close,
  .menu-toggle[aria-expanded="true"] .icon-open {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .icon-close {
    display: inline;
  }

  /* Never shown above the breakpoint, so a menu left open while resizing
     up cannot leak onto the desktop layout. */
  .mobile-nav {
    display: none;
    border-top: 1px solid var(--border);
  }

  .mobile-nav-inner {
    flex-direction: column;
    gap: 4px;
    /* padding-block only — the shared .container rule owns the inline padding. */
    padding-block: 12px 16px;
  }

  /* :not(.btn) so the CTA keeps the global button padding and color. */
  .mobile-nav a:not(.btn) {
    padding: 10px 4px;
    color: var(--text-secondary);
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .mobile-nav a:not(.btn):hover {
    color: var(--primary);
  }

  .mobile-nav .btn {
    margin-top: 8px;
  }

  @media (max-width: 720px) {
    .nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .mobile-nav.is-open {
      display: block;
    }

    .mobile-nav.is-open .mobile-nav-inner {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-nav");

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });

  // In-page anchors (#features, #demo, #faq) don't navigate, so the panel
  // would stay open on top of the section the user just jumped to.
  menu?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (!event.target.closest("a")) return;
    menu.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
  });
</script>
