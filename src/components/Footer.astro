---
import { SITE } from "../consts.ts";
import { useTranslations, getLocalizedPath, type Lang } from "../i18n/utils.ts";

interface Props {
  lang?: Lang;
}
const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const copyright = t.footerCopyright.replace("{year}", String(year));

// 把字典里的占位符替换为真实 URL
const footerCols = t.footerCols.map((col) => ({
  heading: col.heading,
  links: col.links.map((l) => ({
    label: l.label,
    href: l.href
      .replace("APP_URL", SITE.appUrl)
      .replace("REPO_URL", SITE.repoUrl),
    external: l.external,
  })),
}));

// 本地化页脚链接（除了外部链接 APP_URL / REPO_URL / bayjf.com / llms.txt）
const localizeHref = (href: string) => {
  if (
    href.startsWith("http") ||
    href === "/llms.txt" ||
    href === SITE.appUrl ||
    href === SITE.repoUrl
  ) {
    return href;
  }
  return getLocalizedPath(href, lang);
};

const homeHref = getLocalizedPath("/", lang);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={homeHref} class="brand">
        <img src="/favicon.svg" alt="" width="28" height="28" />
        <span>Splity</span>
      </a>
      <p class="footer-desc">{t.footerTagline}</p>
    </div>

    {
      footerCols.map((col) => (
        <div class="footer-col">
          <h4>{col.heading}</h4>
          {col.links.map((l) => (
            <a
              href={localizeHref(l.href)}
              target={l.external ? "_blank" : undefined}
              rel={l.external ? "noopener noreferrer" : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>
      ))
    }
  </div>

  <div class="container footer-bottom">
    <p>{copyright}</p>
    <p class="footer-meta">{t.footerMeta}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    padding: 64px 0 32px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 12px;
    color: var(--text);
  }

  .footer-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    max-width: 240px;
  }

  .footer-col h4 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 16px;
    font-weight: 600;
  }

  .footer-col a {
    display: block;
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 10px;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-meta {
    font-family: var(--font-mono);
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>
