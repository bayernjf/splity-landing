---
import { SITE, SITE_EN, SITE_ZH } from "../consts.ts";
import {
  getLangFromUrl,
  useTranslations,
  getHtmlLang,
  getOgLocale,
  getAltLangPath,
  getHrefLangUrl,
  type Lang,
} from "../i18n/utils.ts";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: string;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  image = "/og-image.png",
  type = "website",
  publishedDate,
  noindex = false,
} = Astro.props;

// 如果未显式传入 lang，则从 URL 推断
const currentLang: Lang = lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const siteMeta = currentLang === "zh" ? SITE_ZH : SITE_EN;

const pageTitle = title ? `${title} | Splity` : siteMeta.title;
const pageDescription = description ?? siteMeta.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const htmlLang = getHtmlLang(currentLang);
const ogLocale = getOgLocale(currentLang);

// 交替语言 hreflang
const altLang = currentLang === "zh" ? "en" : "zh";
const altHref = getAltLangPath(Astro.url.pathname, altLang);
const altHrefFull = getHrefLangUrl(Astro.url.pathname, altLang, SITE.url);
const curHrefFull = getHrefLangUrl(Astro.url.pathname, currentLang, SITE.url);

// JSON-LD: WebSite + SoftwareApplication
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Splity",
  url: SITE.url,
  description: siteMeta.description,
  inLanguage: siteMeta.locale,
  potentialAction: {
    "@type": "UseAction",
    target: `${SITE.url}/blog/how-to-split-knowledge-into-cards`,
  },
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Splity",
  applicationCategory: "EducationApplication",
  operatingSystem: "Web",
  url: SITE.appUrl,
  description: t.appSchemaDescription,
  inLanguage: siteMeta.locale,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: t.appSchemaFeatureList,
};

const articleSchema =
  type === "article" && publishedDate
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: pageDescription,
        image: imageURL.href,
        datePublished: publishedDate,
        dateModified: publishedDate,
        author: { "@type": "Organization", name: SITE.author },
        publisher: { "@type": "Organization", name: SITE.author },
        mainEntityOfPage: canonicalURL.href,
        inLanguage: siteMeta.locale,
      }
    : null;

// RSS 链接按语言区分
const rssPath = currentLang === "zh" ? "/zh/rss.xml" : "/rss.xml";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Splity" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content={ogLocale} />
    {altLang === "zh" && <meta property="og:locale:alternate" content="zh_CN" />}
    {altLang === "en" && <meta property="og:locale:alternate" content="en_US" />}

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageURL} />

    {/* 主题色：与 splity 应用紫色主色一致 */}
    <meta name="theme-color" content="#863bff" />

    {/* hreflang 交替语言 */}
    <link rel="alternate" hreflang={htmlLang} href={curHrefFull} />
    <link rel="alternate" hreflang={altLang === "zh" ? "zh-CN" : "en"} href={altHrefFull} />
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site).href} />

    {/* RSS 订阅 */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Splity Blog"
      href={new URL(rssPath, Astro.site)}
    />

    {/* JSON-LD 结构化数据 */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    {
      articleSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(articleSchema)}
        />
      )
    }

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
