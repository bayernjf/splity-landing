---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE } from "../../consts.ts";
import { useTranslations, type Lang } from "../../i18n/utils.ts";
import "../../styles/global.css";

const lang = "zh" as const satisfies Lang;
const t = useTranslations(lang);

// 中文关于页描述与原始版本保持一致
const description = "Splity 是一款纯前端的智能知识点分割工具，由独立开发者构建，聚焦隐私与学习效率。";

const splitStackItem = (item: string) => {
  const match = item.match(/^([^:：]+)([:：])(.*)$/);
  if (!match) return { label: "", sep: "", value: item };
  return { label: match[1], sep: match[2], value: match[3] };
};
---

<BaseLayout
  lang={lang}
  title={t.aboutTitle}
  description={description}
>
  <Header lang={lang} />
  <main>
    <section class="section">
      <div class="container container-narrow">
        <span class="section-eyebrow">{t.aboutEyebrow}</span>
        <h1>{t.aboutTitle}</h1>

        <p class="lead">
          {t.aboutLead}<strong>{t.aboutLeadHighlight}</strong>
        </p>

        <h2>{t.aboutWhyTitle}</h2>
        <p>
          {t.aboutWhyP1}<strong>{t.aboutWhyP1Highlight}</strong>
        </p>

        <h2>{t.aboutStackTitle}</h2>
        <ul>
          {t.aboutStack.map((item) => {
            const { label, sep, value } = splitStackItem(item);
            return (
              <li>
                <strong>{label}</strong>{sep}{value}
              </li>
            );
          })}
        </ul>

        <h2>{t.aboutPrivacyTitle}</h2>
        <p>
          {t.aboutPrivacyP1}<strong>{t.aboutPrivacyP1Highlight}</strong>{" "}
          <a href="/zh/privacy" class="link">{t.aboutPrivacyLink}</a>。
        </p>

        <h2>{t.aboutOpenTitle}</h2>
        <p>
          {t.aboutOpenP1}{" "}
          <a href={SITE.repoUrl} class="link">{t.aboutOpenLink}</a> 开放。
        </p>

        <h2>{t.aboutRoadmapTitle}</h2>
        <ul>
          {t.aboutRoadmap.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .container-narrow { max-width: 720px; }
  .lead { font-size: 1.2rem; color: var(--text-secondary); margin: 16px 0 40px; line-height: 1.7; }
  h1 { margin-bottom: 8px; }
  h2 { font-size: 1.4rem; margin: 40px 0 16px; }
  p { margin-bottom: 16px; line-height: 1.8; }
  ul { margin: 0 0 16px 1.5em; }
  li { margin-bottom: 8px; color: var(--text-secondary); line-height: 1.7; }
  .link { color: var(--primary); text-decoration: underline; text-underline-offset: 2px; }
  .link:hover { text-decoration: none; }
</style>
