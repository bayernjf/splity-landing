---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { useTranslations, getLocalizedPath, type Lang } from "../../i18n/utils.ts";

const lang = "zh" as const satisfies Lang;
const t = useTranslations(lang);
const homeHref = getLocalizedPath("/", lang);
---

<BaseLayout
  lang={lang}
  title="404: 页面不存在"
  description="你访问的 Splity 页面不存在或已被移动。"
  noindex
>
  <Header lang={lang} />
  <main>
    <section class="section">
      <div class="container container-narrow" style="text-align: center; padding-top: 4rem; padding-bottom: 4rem;">
        <span class="section-eyebrow">{t.notFoundEyebrow}</span>
        <h1>{t.notFoundTitle}</h1>
        <p class="lead">{t.notFoundDesc}</p>
        <p style="margin-top: 2rem;">
          <a href={homeHref} style="color: var(--accent); font-weight: 600; text-decoration: none;">{t.notFoundBack}</a>
        </p>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
