---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { useTranslations, getLocalizedPath, getDateLocale, type Lang } from "../../../i18n/utils.ts";
import "../../../styles/global.css";

const lang = "zh" as const satisfies Lang;
const t = useTranslations(lang);

// 中文博客列表使用 blog 集合（src/content/blog/ 顶层）
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    slug: post.id,
    ...post.data,
  }));

const dateLocale = getDateLocale(lang);
const formatDate = (d: Date) =>
  d.toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" });

const blogBase = getLocalizedPath("/blog", lang);
---

<BaseLayout
  lang={lang}
  title={t.blogTitle}
  description={t.rssDescription}
>
  <Header lang={lang} />
  <main>
    <section class="section">
      <div class="container container-narrow">
        <span class="section-eyebrow">{t.blogEyebrow}</span>
        <h1 class="page-title">{t.blogTitle}</h1>
        <p class="page-subtitle">
          {t.blogSubtitle}
        </p>

        <div class="post-list">
          {
            posts.map((post) => (
              <article class="post-item">
                <a href={`${blogBase}/${post.slug}`} class="post-link">
                  <h2 class="post-title">{post.title}</h2>
                  <p class="post-desc">{post.description}</p>
                  <div class="post-meta">
                    <time datetime={post.pubDate.toISOString()}>
                      {formatDate(post.pubDate)}
                    </time>
                    <span class="dot">·</span>
                    <div class="post-tags">
                      {post.tags.map((tag: string) => (
                        <span class="post-tag">{tag}</span>
                      ))}
                    </div>
                  </div>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .container-narrow { max-width: 760px; }
  .page-title { margin: 8px 0 12px; }
  .page-subtitle { color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 56px; }
  .post-list { display: flex; flex-direction: column; gap: 8px; }
  .post-item { border-bottom: 1px solid var(--border); }
  .post-link { display: block; padding: 32px 0; transition: transform 0.2s; }
  .post-link:hover { transform: translateX(4px); }
  .post-link:hover .post-title { color: var(--primary); }
  .post-title { font-size: 1.4rem; margin-bottom: 8px; transition: color 0.2s; }
  .post-desc { color: var(--text-secondary); margin-bottom: 16px; line-height: 1.6; }
  .post-meta { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--text-muted); font-family: var(--font-mono); }
  .dot { opacity: 0.4; }
  .post-tags { display: flex; gap: 8px; }
  .post-tag { color: var(--primary); }
</style>
