---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { useTranslations, getLocalizedPath, getDateLocale, type Lang } from "../../../i18n/utils.ts";
import "../../../styles/global.css";

const lang = "zh" as const satisfies Lang;
const t = useTranslations(lang);

export async function getStaticPaths() {
  // 中文博客详情页使用 blog 集合（src/content/blog/ 顶层）
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateLocale = getDateLocale(lang);
const formatDate = (d: Date) =>
  d.toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" });

const blogBase = getLocalizedPath("/blog", lang);
---

<BaseLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedDate={post.data.pubDate.toISOString()}
>
  <Header lang={lang} />
  <main>
    <article class="section">
      <div class="container container-narrow">
        <a href={blogBase} class="back-link">{t.blogBack}</a>

        <header class="post-header">
          <h1 class="post-title">{post.data.title}</h1>
          <p class="post-lead">{post.data.description}</p>
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            {
              post.data.updatedDate && (
                <span class="updated">
                  {t.blogUpdatedLabel.replace("{date}", formatDate(post.data.updatedDate))}
                </span>
              )
            }
          </div>
          {
            post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((tag: string) => (
                  <span class="post-tag">{tag}</span>
                ))}
              </div>
            )
          }
        </header>

        <div class="prose">
          <Content />
        </div>
      </div>
    </article>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .container-narrow { max-width: 720px; }
  .back-link {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 32px;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--primary); }

  .post-header { margin-bottom: 48px; padding-bottom: 32px; border-bottom: 1px solid var(--border); }
  .post-title { font-size: 2rem; margin-bottom: 16px; line-height: 1.3; }
  .post-lead { font-size: 1.15rem; color: var(--text-secondary); margin-bottom: 20px; }
  .post-meta { font-size: 0.9rem; color: var(--text-muted); font-family: var(--font-mono); margin-bottom: 16px; }
  .post-tags { display: flex; gap: 12px; flex-wrap: wrap; }
  .post-tag { font-family: var(--font-mono); font-size: 0.8rem; color: var(--primary); }

  .prose { font-size: 1.05rem; line-height: 1.8; color: var(--text); }
  .prose :global(h2) { font-size: 1.5rem; margin: 40px 0 16px; }
  .prose :global(h3) { font-size: 1.2rem; margin: 32px 0 12px; }
  .prose :global(p) { margin-bottom: 20px; color: var(--text); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 20px 1.5em; }
  .prose :global(li) { margin-bottom: 8px; color: var(--text); }
  .prose :global(strong) { color: var(--text); font-weight: 700; }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg-soft);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--primary);
  }
</style>
